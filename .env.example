APP_ENV=development
# En producción APP_ENV=production exige un SECRET_KEY aleatorio real (no este).
# Genérelo con: uv run python -c "from app.auth import fresh_secret; print(fresh_secret())"
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analista_ia
PORT=8000

# Demo users (solo desarrollo; en DB solo se guarda el hash PBKDF2).
ADVISOR_DEMO_EMAIL=advisor.demo@motos.local
ADVISOR_DEMO_PASSWORD=demo-asesor-123
SUPERVISOR_DEMO_EMAIL=supervisor.demo@motos.local
SUPERVISOR_DEMO_PASSWORD=demo-supervisor-123
ADMIN_DEMO_EMAIL=admin.demo@motos.local
ADMIN_DEMO_PASSWORD=demo-admin-123

# AI extraction. Leave keys empty; never commit real values.
#
# Desarrollo: AI_PROVIDER=ollama funciona con un Ollama local (localhost:11434).
# Producción (APP_ENV=production): NO se admite Ollama. Configure un proveedor
# remoto, p. ej.:
#     APP_ENV=production
#     AI_PROVIDER=openrouter
#     OPENROUTER_API_KEY=<clave real por entorno, nunca en el repo>
#     OPENROUTER_MODEL=<modelo con salida JSON>
# o con Groq como proveedor remoto alternativo:
#     AI_PROVIDER=groq
#     GROQ_API_KEY=<clave real por entorno, nunca en el repo>
#     GROQ_MODEL=openai/gpt-oss-20b
# Proveedor local (solo desarrollo): delega en el Local AI Agent en loopback,
# que a su vez habla con Ollama. Nunca exponerlo a Internet ni usarlo en prod.
#     AI_PROVIDER=local
#     LOCAL_AI_AGENT_URL=http://127.0.0.1:8765
#     LOCAL_AI_MODEL=qwen2.5:3b
# La API falla al arrancar si la configuración de IA de producción es inválida.
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Groq (tercer proveedor; API compatible con OpenAI Chat Completions).
# GROQ_MODEL default: openai/gpt-oss-20b (ver app/ai/groq.py). Descomente para
# fijar otro modelo documentado de https://console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Local AI Agent (proveedor `local`, solo desarrollo/loopback).
LOCAL_AI_AGENT_URL=http://127.0.0.1:8765
LOCAL_AI_MODEL=qwen2.5:3b
